+// A model reuses a small palette across thousands of vertices and every animation frame, and the sRGB to linear
+// conversion is the hot path of building and animating effects, so each packed colour is converted once.
+const workingRgb = new Map<number, readonly [number, number, number]>();
+
+/** Convert a packed cache display/sRGB colour to Three.js working-space RGB. The result is shared: do not mutate. */
+export function cacheColorToRgb(value: number): readonly [number, number, number] {
+  let rgb = workingRgb.get(value);
+  if (!rgb) {
+    const color = new THREE.Color(value);
+    rgb = [color.r, color.g, color.b];
+    workingRgb.set(value, rgb);
+  }
+  return rgb;
 }
 
