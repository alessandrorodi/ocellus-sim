{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'the sim is hosted on Cloudflare Pages; Vercel only redirects'",
  "buildCommand": "mkdir -p dist",
  "outputDirectory": "dist",
  "redirects": [{ "source": "/:path*", "destination": "https://ocellus-sim.pages.dev/:path*", "permanent": true }]
}
