{
  "name": "ocellus-sim",
  "version": "0.1.0",
  "private": true,
  "description": "A free practice simulator for the whole Ocellus fight in The Fractured Archive, all four phases. Forked from ArchiveOcellusTrainer.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Julian-Dasilva/ArchiveOcellusTrainer.git"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "test": "jest",
    "typecheck": "tsc --noEmit && node scripts/check-types.mjs",
    "assets": "bash scripts/assets.sh",
    "item-icons": "tsx src/itemIcons/build.ts",
    "deploy": "vercel deploy --prod"
  },
  "devDependencies": {
    "@types/jest": "^27.4.1",
    "@types/node": "16.4.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.163.0",
    "copy-webpack-plugin": "^9.0.1",
    "jest": "^27.5.1",
    "ts-jest": "^27.1.4",
    "ts-loader": "^9.5.1",
    "tsx": "4.23.13",
    "typescript": "^4.9.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^3.11.3"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "three": "^0.163.0"
  }
}
